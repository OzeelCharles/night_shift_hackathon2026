# Clés d'API des modèles de langage utilisés par Rivezli.
# Copie ce fichier en « .env » (même dossier que run.py), colle tes clés après le « = »
# (sans espace ni guillemets), puis relance : python run.py
# Le fichier .env est ignoré par git : tes clés ne partent jamais sur GitHub.

# ------------------------------------------------------------------ Groq (offre gratuite)
# Où la créer : https://console.groq.com > API Keys (gratuit, sans carte bancaire). Elle commence par « gsk_ ».
# Une seule clé pour tous ces modèles :
#   - openai/gpt-oss-120b : assistant (bulle de discussion), QCM / exercices / notebooks de l'atelier « Réviser »
#   - openai/gpt-oss-20b  : assistant, résumé de l'historique des conversations
#   - qwen/qwen3.8-27b    : lecture de photos (emploi du temps, notes de cours)
GROQ_API_KEY=

# ------------------------------------------------------------------ Claude (Anthropic, payant)
# Où la créer : https://console.anthropic.com > API Keys. Elle commence par « sk-ant- ».
#   - claude-opus-5-5  : assistant (bulle de discussion), prioritaire sur Groq dès que cette clé est remplie :
#                        réponses plus rapides, affichées au fil de l'écriture, lecture directe des photos
#   - claude-haiku-5-5 : assistant, résumé de l'historique des conversations
#   - claude-opus-5-5  : atelier « Réviser » (QCM, exercices, notebooks), lit les PDF eux-mêmes, formules comprises
# Attention : pour l'atelier « Réviser », si GROQ_API_KEY est aussi remplie, c'est Groq qui est utilisé.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ Mise en ligne (voir DEPLOY.md)
# Ces variables ne servent qu'une fois le site hébergé ; en local, laisse-les vides.
# RIVEZLI_ENV=production        # cookie de session sécurisé (https), clé secrète obligatoire
# SECRET_KEY=                   # longue chaîne aléatoire : python -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_EMAIL=                  # compte administrateur créé au premier démarrage
# ADMIN_PASSWORD=
# INSTANCE_DIR=/data            # dossier durable (base SQLite, documents) : le disque du projet est effacé à chaque déploiement
# TRUST_PROXY=1                 # nombre de reverse proxies devant l'appli (1 chez presque tous les hébergeurs ; 0 pour désactiver)
# DONATION_URL=                 # page de don https://… (sinon : « Le lien de don arrive bientôt »)
